    {
      "id": 6,
      "title": "Gateway latency p95",
      "type": "timeseries",
      "description": "Request duration including Redis and upstream, for all API responses. Zero means there were no requests in the 30 second interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1000 * histogram_quantile(0.95, sum by (le) (rate(gateway_request_duration_seconds_bucket[30s]))) >= 0) or on() (0 * sum(gateway_request_duration_seconds_count))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
